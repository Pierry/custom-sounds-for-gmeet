{
  "manifest_version": 3,
  "name": "Custom Sounds for GMeet",
  "version": "1.0.0",
  "description": "Replace Google Meet join, leave, and raise-hand sounds with your own, in 3D spatial audio. Runs automatically.",
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["detect.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["ui.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sounds/*"],
      "matches": ["https://meet.google.com/*"]
    }
  ]
}
